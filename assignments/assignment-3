        "def xyxy_to_z(box):\n",
        "    \"\"\"[x1, y1, x2, y2] to the measurement [cx, cy, w, h].\"\"\"\n",
        "    x1, y1, x2, y2 = box[:4]\n",
        "    return np.array([(x1 + x2) / 2, (y1 + y2) / 2, x2 - x1, y2 - y1])\n",
        "\n",
        "\n",
        "def z_to_xywh(z):\n",
        "    \"\"\"[cx, cy, w, h] to the evaluation format [x, y, w, h] (top-left corner).\"\"\"\n",
        "    cx, cy, w, h = z\n",
        "    return np.array([cx - w / 2, cy - h / 2, w, h])"
