        "\n",
        "def run_tracker(dets, first_box, **params):\n",
        "    params = dict(params)\n",
        "\n",
        "    rescue_conf = float(params.pop(\"rescue_conf\", 0.05))\n",
        "    rescue_confirm = int(params.pop(\"rescue_confirm\", 2))\n",
        "    output_conf = float(params.pop(\"output_conf\", 0.02))\n",
        "    detector_weight = float(params.pop(\"detector_weight\", 0.85))\n",
        "    show_coast = bool(params.pop(\"show_coast\", False))\n",
        "\n",
        "    allow_reacquire = params.get(\"reacquire\", True)\n",
        "\n",
        "    tracker = DroneTracker(**params)\n",
        "\n",
        "    x, y, w, h = np.asarray(first_box, dtype=float)\n",
        "    tracker.start([x + w / 2, y + h / 2, w, h])\n",
        "\n",
        "    output = np.full((len(dets), 4), np.nan)\n",
        "    output[0] = first_box\n",
        "\n",
        "    candidate = None\n",
        "    consistent = 0\n",
        "\n",
        "    for i in range(1, len(dets)):\n",
        "        frame_dets = np.asarray(\n",
        "            dets[i], dtype=float\n",
        "        ).reshape(-1, 5)\n",
        "\n",
        "        prediction = tracker.step(frame_dets)\n",
        "        valid = tracker._valid_detections(frame_dets)\n",
        "\n",
        "        if not allow_reacquire and tracker.kf is None:\n",
        "            continue\n",
        "\n",
        "        if len(valid) == 0:\n",
        "            if show_coast and np.isfinite(prediction[0]):\n",
        "                output[i] = prediction\n",
        "            continue\n",
        "\n",
        "        best = valid[np.argmax(valid[:, 4])]\n",
        "        confidence = float(best[4])\n",
        "\n",
        "        measured_box = np.array([\n",
        "            best[0],\n",
        "            best[1],\n",
        "            best[2] - best[0],\n",
        "            best[3] - best[1]\n",
        "        ])\n",
        "\n",
        "        overlap = iou_xywh(\n",
        "            prediction.reshape(1, 4),\n",
        "            measured_box.reshape(1, 4)\n",
        "        )[0]\n",
        "\n",
        "        disagreement = (\n",
        "            not np.isfinite(prediction[0])\n",
        "            or overlap < 0.1\n",
        "        )\n",
        "\n",
        "        # Look for a consistent alternative target\n",
        "        if (\n",
        "            allow_reacquire\n",
        "            and disagreement\n",
        "            and confidence >= rescue_conf\n",
        "        ):\n",
        "            z = xyxy_to_z(best)\n",
        "\n",
        "            if candidate is not None:\n",
        "                distance = np.linalg.norm(\n",
        "                    z[:2] - candidate[:2]\n",
        "                )\n",
        "                radius = max(\n",
        "                    40.0,\n",
        "                    2.0 * max(z[2], z[3])\n",
        "                )\n",
        "\n",
        "                if distance <= radius:\n",
        "                    consistent += 1\n",
        "                else:\n",
        "                    consistent = 1\n",
        "            else:\n",
        "                consistent = 1\n",
        "\n",
        "            candidate = z.copy()\n",
        "\n",
        "            if consistent >= rescue_confirm:\n",
        "                tracker.start(z)\n",
        "                prediction = tracker._get_box()\n",
        "                candidate = None\n",
        "                consistent = 0\n",
        "                disagreement = False\n",
        "        else:\n",
        "            candidate = None\n",
        "            consistent = 0\n",
        "\n",
        "\n",
        "        if confidence >= output_conf:\n",
        "            if disagreement:\n",
        "                output[i] = measured_box\n",
        "            else:\n",
        "                output[i] = (\n",
        "                    detector_weight * measured_box\n",
        "                    + (1 - detector_weight) * prediction\n",
        "                )\n",
        "\n",
        "    return output\n"
      ]
    },
