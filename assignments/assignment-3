        "\n",
        "import numpy as np\n",
        "from filterpy.kalman import KalmanFilter\n",
        "from scipy.stats import chi2\n",
        "\n",
        "class DroneTracker:\n",
        "\n",
        "    def __init__(\n",
        "        self,\n",
        "        accel_std=6.0,\n",
        "        meas_std=10.0,\n",
        "        size_std=2.0,\n",
        "        gate_prob=0.995,\n",
        "        max_coast=6,\n",
        "        min_conf=0.01,\n",
        "        reacquire_conf=0.10,\n",
        "        weak_reacquire_conf=0.02,\n",
        "        reacquire_confirm=2,\n",
        "        reacquire=True\n",
        "    ):\n",
        "        self.accel_std = float(accel_std)\n",
        "        self.meas_std = float(meas_std)\n",
        "        self.size_std = float(size_std)\n",
        "        self.gate_sq = chi2.ppf(gate_prob, df=4)\n",
        "\n",
        "        self.max_coast = max_coast\n",
        "        self.min_conf = min_conf\n",
        "        self.reacquire_conf = reacquire_conf\n",
        "        self.weak_reacquire_conf = weak_reacquire_conf\n",
        "        self.reacquire_confirm = reacquire_confirm\n",
        "        self.reacquire = reacquire\n",
        "\n",
        "        self.kf = None\n",
        "        self.missed = 0\n",
        "        self.pending_z = None\n",
        "        self.pending_count = 0\n",
        "\n",
        "    def start(self, z):\n",
        "        z = np.asarray(z, dtype=float).reshape(4)\n",
        "\n",
        "        self.kf = KalmanFilter(dim_x=6, dim_z=4)\n",
        "\n",
        "        # State: center, velocity, width, height\n",
        "        self.kf.x = np.array([\n",
        "            [z[0]], [z[1]],\n",
        "            [0.0], [0.0],\n",
        "            [max(1.0, z[2])],\n",
        "            [max(1.0, z[3])]\n",
        "        ])\n",
        "\n",
        "        # Constant-velocity transition\n",
        "        self.kf.F = np.eye(6)\n",
        "        self.kf.F[0, 2] = 1.0\n",
        "        self.kf.F[1, 3] = 1.0\n",
        "\n",
        "        # Observe center and box size\n",
        "        self.kf.H = np.zeros((4, 6))\n",
        "        self.kf.H[0, 0] = 1.0\n",
        "        self.kf.H[1, 1] = 1.0\n",
        "        self.kf.H[2, 4] = 1.0\n",
        "        self.kf.H[3, 5] = 1.0\n",
        "\n",
        "        # Process noise\n",
        "        a2 = self.accel_std ** 2\n",
        "        Q = np.zeros((6, 6))\n",
        "\n",
        "        for pos, vel in [(0, 2), (1, 3)]:\n",
        "            Q[pos, pos] = a2 / 4\n",
        "            Q[pos, vel] = a2 / 2\n",
        "            Q[vel, pos] = a2 / 2\n",
        "            Q[vel, vel] = a2\n",
        "\n",
        "        Q[4, 4] = self.size_std ** 2\n",
        "        Q[5, 5] = self.size_std ** 2\n",
        "        self.kf.Q = Q\n",
        "\n",
        "        # Measurement noise\n",
        "        m2 = self.meas_std ** 2\n",
        "        self.kf.R = np.eye(4) * m2\n",
        "\n",
        "        # Initial covariance\n",
        "        self.kf.P = np.diag([\n",
        "            4 * m2, 4 * m2,\n",
        "            400, 400,\n",
        "            4 * m2, 4 * m2\n",
        "        ])\n",
        "\n",
        "        self.missed = 0\n",
        "        self.pending_z = None\n",
        "        self.pending_count = 0\n",
        "\n",
        "    def _get_box(self):\n",
        "        z = (self.kf.H @ self.kf.x).reshape(4)\n",
        "        z[2:] = np.maximum(z[2:], 1.0)\n",
        "        return z_to_xywh(z)\n",
        "\n",
        "    def _valid_detections(self, dets):\n",
        "        d = np.asarray(dets, dtype=float).reshape(-1, 5)\n",
        "\n",
        "        mask = (\n",
        "            (d[:, 4] >= self.min_conf) &\n",
        "            (d[:, 2] > d[:, 0]) &\n",
        "            (d[:, 3] > d[:, 1])\n",
        "        )\n",
        "\n",
        "        return d[mask]\n",
        "\n",
        "    def _reacquire(self, dets):\n",
        "        if not self.reacquire or len(dets) == 0:\n",
        "            return np.full(4, np.nan)\n",
        "\n",
        "        valid = dets[\n",
        "            dets[:, 4] >= self.weak_reacquire_conf\n",
        "        ]\n",
        "\n",
        "        if len(valid) == 0:\n",
        "            self.pending_z = None\n",
        "            self.pending_count = 0\n",
        "            return np.full(4, np.nan)\n",
        "\n",
        "        best = valid[np.argmax(valid[:, 4])]\n",
        "        z = xyxy_to_z(best)\n",
        "\n",
        "        # Strong detection: restart immediately\n",
        "        if best[4] >= self.reacquire_conf:\n",
        "            self.start(z)\n",
        "            return self._get_box()\n",
        "\n",
        "        # Weak detection: check consecutive consistency\n",
        "        if self.pending_z is None:\n",
        "            self.pending_count = 1\n",
        "        else:\n",
        "            distance = np.linalg.norm(\n",
        "                z[:2] - self.pending_z[:2]\n",
        "            )\n",
        "\n",
        "            radius = max(\n",
        "                50.0,\n",
        "                3.0 * max(\n",
        "                    z[2], z[3],\n",
        "                    self.pending_z[2],\n",
        "                    self.pending_z[3]\n",
        "                )\n",
        "            )\n",
        "\n",
        "            similar_size = (\n",
        "                0.3 < z[2] / max(self.pending_z[2], 1.0) < 3.0\n",
        "                and\n",
        "                0.3 < z[3] / max(self.pending_z[3], 1.0) < 3.0\n",
        "            )\n",
        "\n",
        "            if distance <= radius and similar_size:\n",
        "                self.pending_count += 1\n",
        "            else:\n",
        "                self.pending_count = 1\n",
        "\n",
        "        self.pending_z = z\n",
        "\n",
        "        if self.pending_count >= self.reacquire_confirm:\n",
        "            self.start(z)\n",
        "            return self._get_box()\n",
        "\n",
        "        return np.full(4, np.nan)\n",
        "\n",
        "    def step(self, dets):\n",
        "        dets = self._valid_detections(dets)\n",
        "\n",
        "        # Reacquire if no active track\n",
        "        if self.kf is None:\n",
        "            return self._reacquire(dets)\n",
        "\n",
        "        # 1. Predict\n",
        "        self.kf.predict()\n",
        "\n",
        "        if len(dets) > 0:\n",
        "            measurements = np.array([\n",
        "                xyxy_to_z(d) for d in dets\n",
        "            ])\n",
        "\n",
        "            predicted = (\n",
        "                self.kf.H @ self.kf.x\n",
        "            ).reshape(4)\n",
        "\n",
        "            innovations = measurements - predicted\n",
        "\n",
        "            S = (\n",
        "                self.kf.H @ self.kf.P @ self.kf.H.T\n",
        "                + self.kf.R\n",
        "            )\n",
        "\n",
        "            solved = np.linalg.solve(\n",
        "                S, innovations.T\n",
        "            ).T\n",
        "\n",
        "            distances = np.sum(\n",
        "                innovations * solved, axis=1\n",
        "            )\n",
        "\n",
        "            # 2. Mahalanobis gating\n",
        "            matches = np.where(\n",
        "                distances <= self.gate_sq\n",
        "            )[0]\n",
        "\n",
        "            if len(matches) > 0:\n",
        "                costs = (\n",
        "                    distances[matches]\n",
        "                    - np.log(\n",
        "                        np.maximum(dets[matches, 4], 1e-6)\n",
        "                    )\n",
        "                )\n",
        "\n",
        "                best_idx = matches[np.argmin(costs)]\n",
        "\n",
        "                # 3. Measurement update\n",
        "                self.kf.update(measurements[best_idx])\n",
        "                self.missed = 0\n",
        "\n",
        "                return self._get_box()\n",
        "\n",
        "        # 4. Handle missing detections\n",
        "        self.missed += 1\n",
        "\n",
        "        if self.missed <= self.max_coast:\n",
        "            return self._get_box()\n",
        "\n",
        "        # 5. Declare lost and attempt reacquisition\n",
